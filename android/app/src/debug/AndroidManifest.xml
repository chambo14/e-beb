<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Dérogation debug uniquement au blocage du trafic HTTP en clair posé
         dans le manifest principal (usesCleartextTraffic="false") — permet de
         tester en local contre `http://localhost` sans affecter le build
         release, qui reste HTTPS uniquement. -->
    <application android:usesCleartextTraffic="true" tools:replace="android:usesCleartextTraffic" />
</manifest>
